# Copy this file to .env and fill in real values. Never commit the real .env.

FLASK_CONFIG=development
SECRET_KEY=change-this-to-a-random-secret-key

# Optional — the app falls back to simulated data when these are unset.
OPENWEATHER_API_KEY=
GEMINI_API_KEY=

# Override only if you want a database location other than instance/chainshield.db
# DATABASE_URL=sqlite:///instance/chainshield.db

RISK_SCAN_INTERVAL_SECONDS=60
PORT=5000
